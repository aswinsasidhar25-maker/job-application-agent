# LLM API Keys (set at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Job Search API Keys
SERPAPI_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Model Configuration (defaults shown)
# OpenAI:    gpt-4o-mini / gpt-4o
# Anthropic: claude-haiku-4-5-20251001 / claude-sonnet-4-20250514
# Gemini:    gemini/gemini-2.0-flash / gemini/gemini-2.5-pro-preview-05-06
# Ollama (FREE, local): ollama/llama3.2 / ollama/llama3.1
#   - Install: https://ollama.com  then run: ollama pull llama3.2
#   - Best for MacBook Air (low RAM): ollama/phi3:mini or ollama/gemma2:2b
MINI_MODEL=gpt-4o-mini
FULL_MODEL=gpt-4o

# Ollama base URL (only needed if using Ollama local models)
OLLAMA_BASE_URL=http://localhost:11434

# Token Budget (monthly USD limit, 0 = unlimited; set 0 for local Ollama)
MONTHLY_TOKEN_BUDGET=10.0

# Database
DATABASE_URL=sqlite:///data/app.db

# ============================================================
# Job Search Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# This project runs on Ollama by default (free, local, no API costs).
# Cloud LLM providers are optional alternatives.
# ============================================================

# ------------------------------------------------------------
# LLM PROVIDER — Choose ONE approach:
# ------------------------------------------------------------

# OPTION A: Ollama (LOCAL — FREE, recommended)
# Install: https://ollama.com
# Pull model: ollama pull llama3.2
# Start server: ollama serve
MINI_MODEL=ollama/llama3.2
FULL_MODEL=ollama/llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# OPTION B: OpenAI (cloud, paid)
# OPENAI_API_KEY=sk-...
# MINI_MODEL=gpt-4o-mini
# FULL_MODEL=gpt-4o

# OPTION C: Anthropic Claude (cloud, paid)
# ANTHROPIC_API_KEY=sk-ant-...
# MINI_MODEL=claude-haiku-4-5-20251001
# FULL_MODEL=claude-sonnet-4-20250514

# OPTION D: Google Gemini (cloud, free tier available — 15 RPM)
# GEMINI_API_KEY=AI...
# MINI_MODEL=gemini/gemini-2.0-flash
# FULL_MODEL=gemini/gemini-2.5-pro-preview-05-06

# Low-RAM Ollama alternatives (MacBook Air / machines with <8GB free):
# MINI_MODEL=ollama/phi3:mini
# FULL_MODEL=ollama/gemma2:2b

# ------------------------------------------------------------
# API KEYS (cloud providers — leave blank if using Ollama)
# ------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------
# JOB SEARCH API KEYS (all optional — JobSpy works without keys)
# ------------------------------------------------------------
# JobSpy (primary source) scrapes LinkedIn, Indeed, Glassdoor — NO KEY NEEDED
# Remotive — NO KEY NEEDED (remote jobs worldwide)
SERPAPI_API_KEY=       # Optional: Google Jobs via SerpAPI (100 free searches/month)
ADZUNA_APP_ID=         # Optional: Adzuna job board (250 free requests/day)
ADZUNA_APP_KEY=        # Optional: Required alongside ADZUNA_APP_ID

# ------------------------------------------------------------
# JOBSPY CONFIGURATION
# ------------------------------------------------------------
# Number of results to fetch per site (LinkedIn + Indeed + Glassdoor)
# Total results = JOBSPY_RESULTS_PER_SITE × 3
# Lower = faster searches, Higher = more coverage
JOBSPY_RESULTS_PER_SITE=10

# ------------------------------------------------------------
# BUDGET & LIMITS
# ------------------------------------------------------------
# Monthly USD spending cap for cloud LLM calls.
# Set to 0 for unlimited (use 0 when running Ollama — it's free).
MONTHLY_TOKEN_BUDGET=0

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
DATABASE_URL=sqlite:///data/app.db

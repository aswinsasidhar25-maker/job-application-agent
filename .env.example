# LLM API Keys (set at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Job Search API Keys
SERPAPI_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Model Configuration (defaults shown)
# OpenAI: gpt-4o-mini / gpt-4o
# Anthropic: claude-haiku-4-5-20251001 / claude-sonnet-4-20250514
# Gemini: gemini/gemini-2.0-flash / gemini/gemini-2.5-pro-preview-05-06
MINI_MODEL=gpt-4o-mini
FULL_MODEL=gpt-4o

# Token Budget (monthly USD limit, 0 = unlimited)
MONTHLY_TOKEN_BUDGET=10.0

# Database
DATABASE_URL=sqlite:///data/app.db
